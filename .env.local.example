# Copy to .env.local and fill in. Required for sign-in + sync (Phase 1+).
# Before migrating, back up the database and rehearse against a restore/staging copy.
# After provisioning, run: bun run db:migrate   (applies migrations to Neon)

# Neon Postgres connection string (auto-injected by the Vercel integration
# once you add Neon in the Vercel dashboard; for local dev, copy from Neon).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the deployed app (no trailing slash). Local dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# Create OAuth client → Web application). Add redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-preview-and-prod-domains>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob read/write token used for bounded avatar uploads and deletion.
BLOB_READ_WRITE_TOKEN=

# OpenAI API key used by the "Generate family photo" feature (gpt-image-2 image
# edits). Required only for that feature; leave blank to disable it.
OPEN_AI_TOKEN=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX). Optional: leave blank
# to disable analytics, e.g. in local dev or test environments.
NEXT_PUBLIC_GA_ID=

# Transactional email over SMTP (e.g. Zoho Mail). Used to notify the tree owner
# of a new access request and the requester when it is resolved. Leave all blank
# to skip email delivery (the request/approval flow still works without it).
# Zoho Mail SMTP: host smtp.zoho.com, port 465 (SSL) or 587 (STARTTLS); use an
# app-specific password for SMTP_USER.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
